# Secrets
.env
.env.*
!.env.example
web/.env.local

# Dependencies and builds
node_modules/
web/node_modules/
web/.next/
web/out/
web/*.tsbuildinfo
web/next-env.d.ts

# Local runtime data
web/data/*
!web/data/.gitkeep
content/_media/*
!content/_media/.gitkeep
downloads/
research/_state.json

# Optional browser sessions / local targets
web/scripts/group_poster/profiles/
web/scripts/group_poster/targets.json

# Logs and OS files
*.log
*.pid
.DS_Store
Thumbs.db

# Hosting tools
.vercel/
.wrangler/
.cloudflared/

# Video build sandboxes: chi giu template/scaffold, khong giu output
edit-agent/sandbox/*/node_modules/
edit-agent/sandbox/*/.cache/
edit-agent/sandbox/*/video-projects/*
!edit-agent/sandbox/*/video-projects/.gitkeep
!edit-agent/sandbox/*/video-projects/scaffold-yt-summary/
edit-agent/sandbox/*/renders/
**/preview/
**/.frames/

