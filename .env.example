# Contentta Content Agent
# Copy file này thành .env. Không commit .env lên GitHub.

# --- ĐƯỜNG DẪN LOCAL (đều không bắt buộc) ---
# Mặc định app dùng content/, _system/, research/ trong repo này.
CONTENT_AGENT_ROOT=
CONTENT_DIR=
SYSTEM_DIR=
RESEARCH_DIR=
DOWNLOAD_DIR=
YT_DLP_PATH=

# Nhận diện dùng trong ảnh/render và một số màn hình
BRAND_PERSON_NAME=
BRAND_NAME=
BRAND_DOMAIN=
TIKTOK_HANDLE=

# Mirror Obsidian (để trống nếu không dùng)
OBSIDIAN_CONTENT_DIR=
OBSIDIAN_RESEARCH_DIR=

# --- ĐĂNG BÀI / ANALYTICS / INBOX (không bắt buộc để mở app) ---
# Nhiều Zernio workspace: phân cách key bằng dấu phẩy.
ZERNIO_API_KEY=
ZERNIO_API_BASE=https://zernio.com/api/v1
ZERNIO_POLL_MINUTES=5


# --- RESEARCH / ANALYTICS (tuỳ chọn) ---
APIFY_API_KEY=
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SOCIAVAULT_API_KEY=
SOCIAVAULT_API_BASE=https://api.sociavault.com

# YouTube: API key + handle cho dữ liệu public, hoặc OAuth cho kênh của bạn.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# --- TẠO ẢNH BẰNG GEMINI (tuỳ chọn) ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# --- EDIT DAILY NEWS (tuỳ chọn, cần project edit-agent riêng) ---
DAILY_NEWS_BUILD_ENABLED=0
DAILY_NEWS_DIR=

# --- ĐĂNG VÀO GROUP FACEBOOK / ZALO (tuỳ chọn, cần tự dựng zalo-relay) ---
# Zalo chỉ giữ 1 phiên web mỗi tài khoản, nên phiên do relay giữ trên VPS,
# app mở SSH tunnel tới đó. Không có VPS thì bỏ trống, phần group tự tắt.
ZALO_RELAY_URL=http://127.0.0.1:3131
ZALO_RELAY_SECRET=
ZALO_RELAY_SSH_HOST=
ZALO_RELAY_SSH_KEY=
