# Contentta Content Agent
# Copy file này thành .env. KHÔNG commit .env lên GitHub.
# Không có key nào bắt buộc để mở app. Mỗi nhóm dưới đây bật thêm một tính năng.

# --- ĐƯỜNG DẪN LOCAL (không bắt buộc) ---
# Mặc định app dùng content/, _system/, research/, downloads/ ngay trong repo này.
CONTENT_AGENT_ROOT=
CONTENT_DIR=
SYSTEM_DIR=
RESEARCH_DIR=
DOWNLOAD_DIR=
# Cổng app dùng để tự gọi lại chính nó (scheduler research 8h sáng). Mặc định 8502.
CONTENT_AGENT_PORT=

# Đường dẫn yt-dlp nếu không nằm trên PATH.
YT_DLP_PATH=
# Nơi cache video YouTube tải nguyên bản. Mặc định content/_media/_ytcache.
YT_CACHE_DIR=

# Mirror sang Obsidian. Để trống là tắt mirror.
OBSIDIAN_CONTENT_DIR=
OBSIDIAN_RESEARCH_DIR=

# --- ĐĂNG BÀI / ANALYTICS / INBOX ---
# Nhiều Zernio workspace: phân cách key bằng dấu phẩy.
ZERNIO_API_KEY=
ZERNIO_API_BASE=https://zernio.com/api/v1
ZERNIO_POLL_MINUTES=5

# --- RESEARCH / ANALYTICS (tuỳ chọn) ---
APIFY_API_KEY=
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SOCIAVAULT_API_KEY=
SOCIAVAULT_API_BASE=https://api.sociavault.com

# YouTube: API key + handle cho dữ liệu public, hoặc OAuth cho kênh của bạn.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# --- TẠO ẢNH BẰNG GEMINI (tuỳ chọn) ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# --- BUILD VIDEO DỌC (trang /edit/youtube và /edit/daily-news) ---
# Đặt 1 để bật. Tính năng này spawn Claude Code headless nên mặc định tắt.
DAILY_NEWS_BUILD_ENABLED=0
# Thư mục edit-agent. Mặc định là edit-agent/ trong repo này.
EDIT_AGENT_ROOT=
# File .env chứa key TTS nếu bạn để ở nơi khác. Bình thường không cần điền.
EDIT_AGENT_ENV=
# Giữ 1 nếu chạy Claude Code bằng subscription: 2 process headless song song
# sẽ đá nhau khỏi phiên đăng nhập.
DAILY_NEWS_MAX_CONCURRENT=1
DAILY_NEWS_BUILD_MODEL=claude-opus-5
# CTA mời vào group ở cuối video tóm tắt YouTube. Để trống là bỏ CTA group.
GROUP_CTA_URL=
GROUP_CTA_NAME=

# Key cho pipeline build video. Đặt ở đây hoặc trong .env của từng sandbox.
# OpenAI bắt buộc (Whisper transcribe + TTS dự phòng).
OPENAI_API_KEY=
# Vivibe (lucylab) là giọng đọc tiếng Việt. Không có thì tự dùng OpenAI TTS.
VIVIBE_API_KEY=
VOICE_ID=
PIXABAY_API_KEY=

# --- ĐĂNG VÀO GROUP FACEBOOK / ZALO (tuỳ chọn) ---
# Facebook chạy Playwright headed, cần Python và lệnh: pip install playwright
# rồi python -m playwright install chromium.
PYTHON=python
GROUP_POSTER_PROFILES=
# Zalo chỉ giữ 1 phiên web mỗi tài khoản nên phiên do relay giữ trên VPS,
# app mở SSH tunnel tới đó. Không có VPS thì bỏ trống, phần Zalo tự tắt.
ZALO_RELAY_URL=http://127.0.0.1:3131
ZALO_RELAY_SECRET=
ZALO_RELAY_SSH_HOST=
ZALO_RELAY_SSH_KEY=
SSH_BIN=ssh
